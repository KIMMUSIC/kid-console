# ─────────────────────────────────────────────────────────────────────────────
# K-ID API configuration  (copy this file to .env.local and fill in real values)
# ─────────────────────────────────────────────────────────────────────────────

# Server-only API keys issued from the k-ID Compliance Studio — ONE PER PRODUCT.
# The console's "Product (API key)" selector chooses which key each request uses.
# IMPORTANT: these are read ONLY on the server. They are never sent to the browser.
K_ID_PRODUCT_18419_KEY=your_18419_api_key_here
K_ID_PRODUCT_18887_KEY=your_18887_api_key_here

# Which product the UI starts on (must match one of the ids above).
K_ID_DEFAULT_PRODUCT=18419

# Base host for the k-ID API.
#   Test mode: https://game-api.test.k-id.com
#   Live mode: https://game-api.k-id.com
K_ID_API_URL=https://game-api.test.k-id.com

# Optional: webhook signing secret (from the Compliance Studio product settings).
# When set, inbound webhooks are verified with HMAC-SHA256 over (timestamp + rawBody).
WEBHOOK_SECRET=

# Public URL where THIS app is reachable (used in docs / QR helpers).
# In local dev with a tunnel, set this to your ngrok https URL so k-ID can reach
# the webhook at <APP_URL>/api/webhook.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Upstash Redis (REST) — REQUIRED on Vercel for the inspector's
# webhook feed. Serverless instances share no memory, so inbound webhooks are
# stored in Redis and the inspector polls them. Locally these can stay empty
# (a single process keeps events in memory). The Vercel Marketplace Upstash
# integration injects KV_REST_API_URL / KV_REST_API_TOKEN, which also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
